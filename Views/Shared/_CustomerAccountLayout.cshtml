<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RRS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RRS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="font-size: 20px"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between w-100">
                    <!-- Left side can be empty, leaving space for the right side -->
                    <ul class="navbar-nav ms-auto me-5">
                        <!-- `ms-auto` aligns the items to the right -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-action="Index" asp-controller="Customer">Home</a>
                        </li>
                    </ul>
                </div>
                <!-- User Avatar Section - Always visible -->
                <div class="dropdown ms-auto" style="margin-right:10%;">
                    <button class="dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:darkgoldenrod; border-radius:26px; border:none; outline:none;">
                        <img src="~/assets/icons8-user-50.png" alt="User Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                    </button>


                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <li><a class="nav-link text-dark" asp-area="" asp-action="Profile" asp-controller="Profile">Profile</a></li>
                        <li><a class="nav-link text-dark" asp-area="" asp-action="MyReservation" asp-controller="MyReservation">My Reservation</a></li>
                        <li><a class="nav-link text-dark" asp-area="" asp-action="MyReservation" asp-controller="MyReservation">Sign Out</a></li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap Bundle (includes Popper) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
