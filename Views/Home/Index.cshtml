@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- MAIN SECTION -->
<section id="hero" class="height-100">
    <div class="content">
        <h1 style="font-size: 8rem; margin: 0; line-height: 100px; font-family: 'Corbel';">NO LINES,</h1>
        <h1 style="font-size: 6rem; margin: 0; line-height: 0; margin-left:2%; margin-top:2%;">NO WORRIES.</h1>
        <p style="font-size: 0.8rem; margin: 0; line-height: 0; margin-top:3%;">
            Skip the queues, enjoy seamless service with
            us, and experience a hassle-free journey from
        </p>
        <p style="font-size: 0.8rem; margin: 0; line-height: 0;">
            start to finish—because your time is valuable,
            and we’re here to make things easier for you!
        </p>
    </div>
    <img src="~/assets/MENU.png" alt="Right Image" style="position: absolute; top: 35%; right: 5%; transform: translateY(-50%); width: 40vw; height: auto;" />
    <img src="~/assets/2-MENU.png" alt="Right Image" style="position: absolute; top: 70%; right: 5%; transform: translateY(-50%); width: 40vw; height: auto;" />
    <button type="button" class="btn" onclick=""
            style="position: absolute; bottom: 10%; left: 50%; transform: translateX(-50%); padding: 10px 20px; font-size: 1.5rem; background-color: #FFD700; color: #000; border: none; border-radius: 8px;">
        BOOK NOW
    </button>
</section>






