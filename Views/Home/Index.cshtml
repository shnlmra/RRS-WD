<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - RRS</title>

    <!-- Bootstrap and Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.1/css/dataTables.bootstrap5.css">

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.1/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.2.1/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/navbar.js" defer></script>


    <style>
        body {
            height: 100%;
        }
    </style>
</head>
<body>

    <!-- Header Navigation Bar -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <!-- Brand Name -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Golden Palate</a>

            <!-- Toggle button for small screens -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#hero">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#customer" >Customers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#aboutUs">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contactUs">Contact Us</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <!-- Container Main -->
    <div class="container" style="margin-top: 70px;">
        <!-- HERO SECTION -->

        <section id="hero" class="height-100">
            <div class="row">
                <div class="col-12">
                    <div class="half-screen-image" style="background-image: url('@Url.Content("")');"></div>
                </div>
            </div>

            <div class="col-12 text-container" style="text-align: left; margin-top: 3%; margin-left:8%;">
                <img src="~/assets/RRS-Name.png" alt="Golden Palate" style="line-height: 0; width: 30vw; height: 30vh;">
                <p style="font-size: 8rem; margin: 0; line-height: 100px; font-family: 'Corbel';">NO LINES,</p>
                <p style="font-size: 6rem; margin: 0; line-height: 0; margin-left:2%; margin-top:2%;">NO WORRIES.</p>
                <p style="font-size: 0.8rem; margin: 0; line-height: 0; margin-top:3%;">
                    Skip the queues, enjoy seamless service with us, and experience a hassle-free journey from
                </p>
                <p style="font-size: 0.8rem; margin: 0; line-height: 0;">
                    start to finish—because your time is valuable, and we’re here to make things easier for you!
                </p>
            </div>

            <img src="~/assets/MENU.png" alt="Right Image" style="position: absolute; top: 35%; right: 5%; transform: translateY(-50%); width: 40vw; height: auto;" />
            <img src="~/assets/2-MENU.png" alt="Right Image" style="position: absolute; top: 70%; right: 5%; transform: translateY(-50%); width: 40vw; height: auto;" />




            <button type="button" class="btn" onclick="window.location.href='@Url.Action("Reservation", "CReservation")''">
                BOOK NOW
            </button>
        </section>

        <!-- CUSTOMER SECTION -->

        <section id="customer" class="height-100">

            <h1 style="color:white; margin-top:7%; text-align:center; font-weight:bold; animation: slideLeft 1s ease-out;">
                Hungry? We've got you covered!
            </h1>
            <p style="color:white; margin-top:1%; text-align:center; font-weight:bold; animation: slideLeft 1s ease-out;">
                Find your perfect dining match and reserve your table instantly.
            </p>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 20px; color: white; margin: 0 auto; max-width: 1920px; animation: slideLeft 1s ease-out;">
                <div style="padding: 20px; text-align: center; border-radius: 8px;">
                    <img src="~/assets/Customer-1.png" alt="Image 1" style="width: 100%; height: auto; border-radius: 8px; margin-bottom: 20px;">
                    <p style="text-align: justify; margin: 0;">Indulge your senses at Golden Palate, a charming bistro nestled in the historic district of Rodriguez. Our cozy, intimate setting is the perfect place to savor our delectable cuisine and enjoy a glass of fine wine.</p>
                </div>
                <div style="padding: 20px; text-align: center; border-radius: 8px;">
                    <img src="~/assets/Customer-2.png" alt="Image 2" style="width: 100%; height: auto; border-radius: 8px; margin-bottom: 20px;">
                    <p style="text-align: justify; margin: 0;">Indulge your senses at Golden Palate, a charming bistro nestled in the historic district of Rodriguez. Our cozy, intimate setting is the perfect place to savor our delectable cuisine and enjoy a glass of fine wine.</p>
                </div>
                <div style="padding: 20px; text-align: center; border-radius: 8px;">
                    <img src="~/assets/Customer-3.png" alt="Image 3" style="width: 100%; height: auto; border-radius: 8px; margin-bottom: 20px;">
                    <p style="text-align: justify; margin: 0;">Indulge your senses at Golden Palate, a charming bistro nestled in the historic district of Rodriguez. Our cozy, intimate setting is the perfect place to savor our delectable cuisine and enjoy a glass of fine wine.</p>
                </div>
            </div>

        </section>

        <!-- ABOUT US SECTION -->

        <section id="aboutUs" class="height-100">

            <div class="image-container slide-left" style="width: 500px; height: 100%; position: absolute; left: 0; top: 0;">
                <img src="/assets/Final-Sidepic.png" alt="Side Image" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>

            <div class="grid-container" style="margin: 0 auto; text-align: center; max-width: 800px; margin-top:5%;">
                <div class="grid-item">
                    <h2 style="font-weight: bold; text-align: center;">About Us</h2>
                    <p>Welcome to Golden Palate — your ultimate solution for seamless and efficient restaurant bookings! We understand the importance of making dining experiences smooth and hassle-free, whether you're planning a casual dinner or hosting an important event.</p>
                </div>

                <div class="grid-item">
                    <h2 style="font-weight: bold; text-align: center;">Our Mission</h2>
                    <p>To make restaurant reservations easier and more accessible for both guests and restaurant owners. With our user-friendly platform, we bring together customers and restaurants in a way that simplifies the entire process, from discovering available tables to securing reservations in just a few clicks.</p>
                </div>
            </div>


            <div class="image-container slide-left" style="width: 900px; height: 500px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); margin-left:30%; margin-top: 15%;">
                <img src="/assets/RightPic.png" alt="Side Image" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>

        </section>

        <!-- CONTACT US SECTION -->
        <section id="contactUs" class="height-100">

            <div class="contact-title">
                Contact Us
            </div>

            <p style="font-size:1rem; color:darkgoldenrod; margin-top:0%; line-height:2px; text-align:center;">
                Have questions, feedback, or need assistance? We’d love to hear from you!
            </p>

            <div class="grid-container">
                <!-- Left Side: Contact Form -->
                <div class="grid-item justify-content-center align-items-center" style="width:500px; align-content:center; background-color:gray; margin-top:5%; border-radius:26px; height:300px; padding:20px; margin-left:37%;">
                    <form action="#" method="POST">
                        <div class="form-item">
                            <label for="name">Name</label>
                            <input type="text" id="name" name="name" required>
                        </div>

                        <div class="form-item">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required>
                        </div>

                        <div class="form-item" style="">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" rows="4" required></textarea>
                        </div>

                        <button type="submit" class="form-button">Submit</button>
                    </form>
                </div>
            </div>

            <div class="footer">
                <p>&copy; 2025 Your Company Name. All Rights Reserved.</p>
            </div>

        </section>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>




