@model RRS.Models.Reservation

@{
    ViewData["Title"] = "Create Reservation";
    Layout = "~/Views/Shared/_CustomerAccountLayout.cshtml";
}

<div class="text-left mb-2">
    <h1 class="fs-4">Create Reservation</h1>
    <p class="text-secondary">Fill in the form below to create a reservation.</p>
</div>

<form id="reservationForm" asp-action="Create" asp-controller="Reservation" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="tableNumber" class="form-label">Table Number</label>
        <!-- Display Table Number -->
        <p>@Model.Table.TableNumber</p>
        <!-- Hidden field to submit Table Number -->
        <input type="hidden" asp-for="Table.TableNumber" value="@Model.Table.TableNumber" />
    </div>
    <div class="form-group">
        <label for="tablePrice" class="form-label">Table Price</label>
        <!-- Display Table Number -->
        <p>@Model.Table.Price</p>
        <!-- Hidden field to submit Table Number -->
        <input type="hidden" asp-for="Table.Price" value="@Model.Table.Price" />
    </div>

    <div class="form-group">
        <label for="datepicker" class="form-label">Reservation Date</label>
        <p>@Model.ReservationDate</p>
        <input type="hidden" asp-for="ReservationDate" value="@Model.ReservationDate" />
    </div>

    <div class="form-group">
        <label for="timepicker" class="form-label">Reservation Time </label>
        <p>@Model.ReservationTime</p>
        <input type="hidden" asp-for="ReservationTime" value="@Model.ReservationTime" />
    </div>

    <div class="form-group">
        <label for="firstName">First name <span class="text-danger">*</span></label>
        <input type="text" asp-for="Customer.FirstName" id="firstName" class="form-control" />
        <span asp-asp-validation-for="Customer.FirstName" class="text-danger"></span>
        <span id="firstNameError" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="lastName">Last name <span class="text-danger">*</span></label>
        <input type="text" asp-for="Customer.LastName" id="lastName" class="form-control" />
        <span id="lastNameError" class="text-danger"></span>
        <span asp-asp-validation-for="Customer.LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="email">Email address <span class="text-danger">*</span></label>
        <input type="email" asp-for="Customer.Email" id="email" class="form-control" />
        <span id="emailError" class="text-danger"></span>
        <span asp-asp-validation-for="Customer.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="phoneNumber">Phone Number <span class="text-danger">*</span></label>
        <input type="text" asp-for="Customer.PhoneNumber" id="phoneNumber" class="form-control" />
        <span id="phoneNumberError" class="text-danger"></span>
        <span asp-asp-validation-for="Customer.PhoneNumber" class="text-danger"></span>
    </div>

    <!-- Buffet Type -->
    <div class="form-group">
        <label for="buffet">Buffet Type</label>
        <select asp-for="BuffetTypeId" id="buffetType" onchange="calculatePrice()">
            <option value="">Select Buffet Type</option>
            <!-- Options will be populated by JavaScript -->
        </select>
        <span asp-validation-for="BuffetTypeId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="specialRequest">Special Request</label>
        <textarea asp-for="SpecialRequest" id="specialRequest" class="form-control" rows="3"></textarea>
        <span asp-asp-validation-for="SpecialRequest" class="text-danger"></span>
    </div>

        <input type="hidden" asp-for="TotalPrice" id="totalPriceInput" name="TotalPrice" value="0" />

    <button type="submit" class="btn btn-primary">Proceed</button>

</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- Ensure jQuery is included -->

<script>

    // Function to populate the buffet types dropdown
    function populateBuffetTypes() {
        $.ajax({
            url: '@Url.Action("GetBuffetTypes", "Reservation")', // URL to the API action
            type: 'GET',
            success: function(data) {
                const buffetSelect = document.getElementById('buffetType');

                // Remove all existing options
                buffetSelect.innerHTML = '<option value="">Select Buffet Type</option>';

                // Add options from the fetched buffet types
                data.forEach(function(buffet) {
                    const option = document.createElement('option');
                    option.value = buffet.id;
                    option.textContent = buffet.buffetName;
                    option.setAttribute('data-price', buffet.buffetPrice);
                    buffetSelect.appendChild(option);
                });
            },
            error: function() {
                alert('Failed to load buffet types');
            }
        });
    }

    // Call the function to populate the dropdown on page load
    $(document).ready(function() {
        populateBuffetTypes();
    });

    // Function to calculate the total price
    function calculatePrice() {
        // Get the selected buffet price
        const buffetSelect = document.getElementById('buffetType');
        const selectedBuffetOption = buffetSelect.options[buffetSelect.selectedIndex];
        const buffetPrice = parseFloat(selectedBuffetOption.getAttribute('data-price') || 0);
        const tablePrice = parseFloat('@Model.Table.Price');

        // Calculate the total price
        const totalPrice = buffetPrice + tablePrice;

        // Display the total price
        document.getElementById('totalPrice').textContent = '₱' + totalPrice.toFixed(2);
        document.getElementById('totalPriceInput').value = totalPrice.toFixed(2);
    }

    document.getElementById("reservationForm").addEventListener("submit", notice);

    function notice(e) {
        e.preventDefault(); // Prevent default form submission

        // Clear existing error messages
        clearErrors();

        // Gather form data for the summary
        const tableNumber = document.getElementById("tableNumber").value;
        const seatingOccupancy = document.getElementById("seatingOccupancy").value;
        const firstName = document.getElementById("firstName").value.trim();
        const lastName = document.getElementById("lastName").value.trim();
        const email = document.getElementById("email").value.trim();
        const phoneNumber = document.getElementById("phoneNumber").value.trim();
        const specialRequest = document.getElementById("specialRequest").value.trim();
        const totalPrice = document.getElementById("totalPriceInput").value.trim();

        // Get the selected buffet name
        const buffetSelect = document.getElementById('buffetType');
        const selectedBuffetOption = buffetSelect.options[buffetSelect.selectedIndex];
        const buffetName = selectedBuffetOption.textContent || selectedBuffetOption.innerText;


        let isValid = true; // Flag to check if all fields are valid

        // Validate each field and display errors if necessary
        if (!firstName) {
            showError("firstNameError", "First name is required.");
            isValid = false;
        }

        if (!lastName) {
            showError("lastNameError", "Last name is required.");
            isValid = false;
        }

        if (!email) {
            showError("emailError", "Email address is required.");
            isValid = false;
        }

        if (!phoneNumber) {
            showError("phoneNumberError", "Phone number is required.");
            isValid = false;
        }

        // If validation fails, stop further execution
        if (!isValid) return;

        // Show reservation summary and terms
        Swal.fire({
            title: 'Reservation Summary',
            html: `
                <p><strong>Table Number:</strong> ${tableNumber}</p>
                <p><strong>Seating Occupancy:</strong> ${seatingOccupancy}</p>
                <p><strong>Buffet Type:</strong> ${buffetName}</p>
                <p><strong>Date:</strong> ${@Model.ReservationDate.ToString("MM/dd/yyyy")}</p>
                <p><strong>Time:</strong> ${@Model.ReservationTime.ToString("HH:mm")}</p>
                <p><strong>Personal Details:</strong></p>
                <p><strong>Name:</strong> ${firstName} ${lastName}</p>
                <p><strong>Email:</strong> ${email}</p>
                <p><strong>Phone Number:</strong> ${phoneNumber}</p>
                <p><strong>Special Request:</strong> ${specialRequest}</p>
                <p><strong>Total Price:</strong> ₱${totalPrice}</p>
            `,
            showCancelButton: true,
            confirmButtonText: 'Confirm and Proceed',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                // Show Terms and Conditions
                    Swal.fire({
                    title: 'Terms and Conditions',
                    html: '<b>Reservation Fee:</b> A non-refundable reservation fee of 30% of the total estimated bill is required to secure your reservation. <br><br><b>Cancellation Policy:</b> Full reservation fee refunded for cancellations made more than 48 hours in advance. <br><br><b>No-shows:</b> Reservation fee will be forfeited.',
                    icon: 'info',
                    confirmButtonText: 'I Understand, Continue',
                    showCancelButton: true,
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // If the user confirms terms and conditions, submit the form
                        document.getElementById("reservationForm").submit(); // Submit the form programmatically
                    }
                });

            }
        });
    }

    // Function to display an error message
    function showError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        errorElement.textContent = message;
    }

    // Function to clear all error messages
    function clearErrors() {
        document.getElementById("firstNameError").textContent = "";
        document.getElementById("lastNameError").textContent = "";
        document.getElementById("emailError").textContent = "";
        document.getElementById("phoneNumberError").textContent = "";
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
                    Swal.fire({
                        title: 'Error!',
                        text: '@TempData["ErrorMessage"]',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
        </text>
    }
</script>
