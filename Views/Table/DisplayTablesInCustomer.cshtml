@model RRS.Models.ViewModels.TableViewModel
@{
    ViewData["Title"] = "Tables";
    Layout = "~/Views/Shared/_CustomerAccountLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-end flex-wrap gap-2 mt-3 mb-4">
    <div class="form-group w-20">
        <label for="datepicker" class="form-label">Select a date</label>
        <input asp-for="Reservation.ReservationDate" type="text" id="datepicker" class="form-control">
    </div>

    <div class="form-group w-20">
        <label for="timepicker" class="form-label">Select Time</label>
        <input asp-for="Reservation.ReservationTime" type="text" id="timepicker" class="form-control">
    </div>

    <div class="form-group w-20">
        <label for="seatingCapacity" class="form-label">Seating Capacity</label>
        <input type="number" id="seatingCapacity" class="form-control bg-light">
    </div>
</div>

<div class="container d-flex flex-wrap align-items-start justify-content-center gap-3">
    @foreach (var table in Model.Tables)
    {
        <div class="card border-0 shadow-sm h-100 d-flex flex-column" style="width: 18rem; min-height: 300px;">
            <img src="@table.TableImagePath" class="card-img-top" alt="...">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Table Number: @table.TableNumber</h5>
                <div class="d-flex align-items-center justify-content-between gap-1 flex-wrap">
                    <p class="card-text text-capitalize text-secondary">Location - @table.TableLocation </p>
                    <p class="card-text text-secondary">Seating Capacity - @table.SeatingCapacity</p>
                </div>
                <p class="card-text text-capitalize text-secondary">Price - ₱@table.Price</p>
                <p class="card-text">@table.Description</p>
                <button type="button" class="btn btn-warning w-100 mt-auto"
                        onclick="submitReservation(@table.TableNumber, @table.Price)">
                    Reserve Now
                </button>
            </div>
        </div>
    }
</div>

<form id="reservationForm" asp-action="ShowReservationForm" asp-controller="Reservation" method="post" style="display:none;">
    <input type="hidden" id="formTableNumber" name="tableNumber" />
    <input type="hidden" asp-for="Table.Price" id="formPrice" name="price" />
    <input type="hidden" id="formDate" name="date" />
    <input type="hidden" id="formTime" name="time" />
</form>

<script>
    // Initialize flatpickr for date and time inputs
    flatpickr("#datepicker", {
        dateFormat: "Y-m-d",
        enableTime: false,
        minDate: "today",
        defaultDate: "today",
    });

    flatpickr("#timepicker", {
        enableTime: true,
        noCalendar: true,
        dateFormat: "h:i K",
        time_24hr: false,
        minTime: "08:00",
        maxTime: "20:00",
        defaultTime: "08:00",
    });

    // Submit reservation logic
    function submitReservation(tableNumber, price) {
        const date = document.getElementById("datepicker").value;
        const time = document.getElementById("timepicker").value;

        if (!date || !time ) {
            Swal.fire({
                title: 'Error!',
                text: 'Please choose your reservation date and time.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
            return;
        }

        if (!tableNumber) {
            Swal.fire({
                title: 'Error!',
                text: 'Please select a table to reserve.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
            return;
        }

        // Set hidden fields before showing the form
        document.getElementById("formTableNumber").value = tableNumber;
        document.getElementById("formDate").value = date;
        document.getElementById("formTime").value = time;
        document.getElementById("formPrice").value = price;

        // Show the form after setting the values
        document.getElementById("reservationForm").style.display = "block";

        // Optionally, submit the form after a user confirmation or directly if you're ready
        document.getElementById("reservationForm").submit();
    }

    // Handle TempData messages
    $(document).ready(function() {
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
                    Swal.fire({
                        title: 'Success!',
                        text: '@TempData["SuccessMessage"]',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
        </text>
    }

    @if (TempData["InformationMessage"] != null)
    {
        <text>
                    Swal.fire({
                        title: 'Information!',
                        text: '@TempData["InformationMessage"]',
                        icon: 'info',
                        confirmButtonText: 'OK'
                    });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
                    Swal.fire({
                        title: 'Error!',
                        text: '@TempData["ErrorMessage"]',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
        </text>
    }
    });
</script>
